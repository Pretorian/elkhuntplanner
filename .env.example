# Environment Configuration Example
# Copy this file to .env and fill in your API keys

# Supabase Configuration (required for authentication)
# Get these from your Supabase project: https://app.supabase.com
# See SUPABASE_SETUP.md for detailed setup instructions
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# GoHunt Insider API Configuration (optional)
# Required for draw odds, weather overlays, and advanced features
# Sign up at: https://www.gohunt.com/insider
VITE_GOHUNT_API_KEY=your_gohunt_api_key_here

# HuntWise API Configuration (optional)
# Required for scouting layers, wind forecasts, and pressure maps
# Sign up at: https://huntwise.com
VITE_HUNTWISE_API_KEY=your_huntwise_api_key_here

# TessaDEM Elevation API Configuration (optional)
# Adds elevation readouts to map waypoints.
# Get a key at: https://tessadem.com/elevation-api/
VITE_TESSADEM_API_KEY=your_tessadem_api_key_here

# Application Environment
VITE_APP_ENV=development
